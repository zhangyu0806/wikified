{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/llm-wiki-session-start\" --format claude --max-chars 2500",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
