{
  "description": "Inject a bounded, redacted LLM Wiki digest when Codex starts, resumes, clears, or compacts a session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/llm-wiki-enrich\" --session-start --max-chars 3500",
            "commandWindows": "wsl.exe -- sh -lc 'exec \"$HOME/.local/bin/llm-wiki-enrich\" --session-start --max-chars 3500'",
            "timeout": 10,
            "statusMessage": "Loading bounded LLM Wiki context",
            "additionalContextLimit": 1600
          }
        ]
      }
    ]
  }
}
