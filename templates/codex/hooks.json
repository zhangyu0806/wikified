{
  "description": "Inject bounded, redacted Wikified critical facts when Codex starts, resumes, clears, or compacts a session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/llm-wiki-session-start\" --format codex --max-chars 2500",
            "commandWindows": "wsl.exe -- sh -lc 'exec \"$HOME/.local/bin/llm-wiki-session-start\" --format codex --max-chars 2500'",
            "timeout": 10,
            "statusMessage": "Loading stable Wikified context",
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
