{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env LLM_WIKI_AGENT_PROFILE=grok LLM_WIKI_DOMAIN=work \"$HOME/.local/bin/llm-wiki-session-start\" --format grok-probe --max-chars 2500",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
