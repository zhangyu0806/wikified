{
  "mcpServers": {
    "llm-wiki": {
      "command": "/absolute/path/to/node",
      "args": ["/absolute/path/to/wikified/bin/llm-wiki-mcp"],
      "env": {
        "LLM_WIKI_AGENT_PROFILE": "pi",
        "LLM_WIKI_DOMAIN": "work",
        "LLM_WIKI_ROOT": "/absolute/path/to/vault",
        "LLM_WIKI_TARGET_AGENTS": "pi"
      },
      "enabled": true,
      "exposure": "direct"
    }
  }
}
