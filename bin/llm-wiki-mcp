#!/usr/bin/env node
'use strict';

// llm-wiki-mcp — Wikified 记忆系统的 MCP server（兼容命令名保留）。
// 薄封装现有 llm-wiki-* CLI，把记忆读写暴露给任意 MCP 客户端
// (OpenCode/Claude Code/Cursor)，逻辑全在 CLI 里，本文件只做 JSON-RPC 转接。
// 纯 Node + 手写 JSON-RPC over stdio，零外部依赖（对齐本机 scraper-fallback-mcp 风格）。

const { execFile } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');

const HOME = os.homedir();
// BIN 必须和 install.sh 的 BIN_TARGET 保持一致，否则 MCP 会静默找不到 CLI。
// install.sh 允许用 LLM_WIKI_BIN_TARGET 改安装位置，这里认同一个变量。
const BIN = process.env.LLM_WIKI_BIN_TARGET || path.join(HOME, '.local', 'bin');
const ROOT = process.env.LLM_WIKI_ROOT || path.join(HOME, 'llm-wiki');
// 优先用与本文件同目录的兄弟 CLI：MCP server 自身通常就在 BIN 里，
// 这样即使 env 没设、安装位置又非默认，也能自洽解析。
const SELF_DIR = __dirname;
// 惰性解析 + 每次调用复验：常驻 MCP 进程可能在启动后遭遇 CLI 目录搬迁
// （如工具链从数据仓拆到独立仓），启动时一次性算死的路径会让进程永久 ENOENT
// 且无法自愈。故缓存命中也要确认文件仍在，失效即重走 SELF_DIR → BIN → PATH。
const cliCache = new Map();
const resolveCli = (name) => {
  const cached = cliCache.get(name);
  if (cached) {
    try { if (fs.existsSync(cached)) return cached; } catch { /* ignore */ }
    cliCache.delete(name);  // 路径已失效，重新解析
  }
  for (const dir of [SELF_DIR, BIN]) {
    const p = path.join(dir, name);
    try { if (fs.existsSync(p)) { cliCache.set(name, p); return p; } } catch { /* ignore */ }
  }
  return name;  // 交给 PATH 兜底
};
const ENRICH = () => resolveCli('llm-wiki-enrich');
const EVENT = () => resolveCli('llm-wiki-event');
// Caller identity is fixed when the server process starts. It is deliberately
// absent from every tool schema: an MCP client must not be able to self-assert
// a more privileged profile in a tool call.
const AGENT_PROFILE = process.env.LLM_WIKI_AGENT_PROFILE || 'coding';
const MEMORY_DOMAIN = process.env.LLM_WIKI_DOMAIN || 'work';
const TARGET_AGENTS = (process.env.LLM_WIKI_TARGET_AGENTS || AGENT_PROFILE)
  .split(',')
  .map((value) => value.trim())
  .filter(Boolean)
  .slice(0, 16);

const run = (file, args, timeoutMs = 8000) =>
  new Promise((resolve) => {
    execFile(file, args, { encoding: 'utf8', timeout: timeoutMs, maxBuffer: 4 * 1024 * 1024 }, (err, stdout, stderr) => {
      if (err) resolve({ ok: false, text: (stderr || stdout || err.message || 'command failed').trim() });
      else resolve({ ok: true, text: (stdout || '').trim() });
    });
  });

const runRequired = async (file, args, timeoutMs = 8000) => {
  const result = await run(file, args, timeoutMs);
  if (!result.ok) throw new Error(result.text || `${path.basename(file)} failed`);
  return result.text;
};

const tools = [
  {
    name: 'search_pages',
    description: 'Search Wikified memory by natural-language query. Returns top relevant wiki pages and memory events, ranked by llm-wiki-enrich.',
    inputSchema: {
      type: 'object',
      properties: {
        query: { type: 'string', description: 'Natural-language query or task description.' },
        project: { type: 'string', description: 'Optional project id used to isolate memory events.' },
        limit: { type: 'integer', minimum: 1, maximum: 20, description: 'Max candidates (default 5).' },
        maxChars: { type: 'integer', minimum: 200, maximum: 8000, description: 'Max output chars (default 2000).' },
      },
      required: ['query'],
    },
  },
  {
    name: 'read_page',
    description: 'Read one authorized Markdown page below wiki/. Path safety and the server-fixed Agent profile policy are enforced before the body is returned.',
    inputSchema: {
      type: 'object',
      properties: {
        path: { type: 'string', description: 'Path relative to the Wikified data root.' },
        project: { type: 'string', description: 'Optional project id that further narrows an explicitly scoped page.' },
      },
      required: ['path'],
    },
  },
  {
    name: 'find_related',
    description: 'Find related concepts/pages through the same policy-filtered retrieval path as search_pages. Direct global-graph traversal is disabled until graphs are profile-partitioned.',
    inputSchema: {
      type: 'object',
      properties: {
        topic: { type: 'string', description: 'Topic or question to traverse from.' },
        budget: { type: 'integer', minimum: 200, maximum: 4000, description: 'Token budget cap (default 1500).' },
      },
      required: ['topic'],
    },
  },
  {
    name: 'list_recent_raw',
    description: 'List recent raw source materials. Disabled for Agent MCP profiles in governance v1; use the human review CLI instead.',
    inputSchema: {
      type: 'object',
      properties: { limit: { type: 'integer', minimum: 1, maximum: 50, description: 'Max entries (default 15).' } },
    },
  },
  {
    name: 'record_event',
    description: 'Propose a typed memory event for human review. Agent-authored events are stored as ai-proposed/pending and cannot be recalled until explicitly approved.',
    inputSchema: {
      type: 'object',
      properties: {
        type: { type: 'string', enum: ['fact', 'decision', 'bug', 'workflow', 'preference', 'architecture', 'touch', 'lesson', 'session'], description: 'Event type.' },
        summary: { type: 'string', description: 'Short event summary.' },
        details: { type: 'string', description: 'Optional longer details.' },
        project: { type: 'string', description: 'Optional project id.' },
        validFrom: { type: 'string', description: 'Optional ISO-8601 date/instant when the event becomes current.' },
        validUntil: { type: 'string', description: 'Optional ISO-8601 date/instant when the event expires.' },
        supersedes: {
          type: 'array',
          items: { type: 'string', pattern: '^[0-9a-f]{16}$' },
          description: 'Existing same-project event ids made obsolete by this event.',
        },
      },
      required: ['type', 'summary'],
    },
  },
  {
    name: 'lint',
    description: 'Repository-wide structural lint. Disabled for Agent MCP profiles in governance v1; run llm-wiki-health locally as the human owner.',
    inputSchema: { type: 'object', properties: {} },
  },
];

async function dispatch(name, args) {
  if (name === 'search_pages') {
    const a = ['--agent-profile', AGENT_PROFILE, '--query', String(args.query || ''), '--limit', String(args.limit || 5), '--max-chars', String(args.maxChars || 2000)];
    if (args.project) a.push('--project', String(args.project));
    return await runRequired(ENRICH(), a);
  }
  if (name === 'read_page') {
    // Keep only input-shape validation here. Existence, realpath, size and ACL
    // checks deliberately happen together inside enrich, which returns the same
    // "page unavailable" error for every denied/missing target. Checking those
    // properties here would let an unauthorized caller enumerate private pages.
    const rel = String(args.path || '');
    const normalized = rel.replaceAll('\\', '/');
    if (!normalized.startsWith('wiki/') || !normalized.endsWith('.md')) {
      throw new Error('read_page only permits wiki/**/*.md');
    }
    // Delegate semantic authorization to the same policy engine used by search
    // so read_page cannot become an ACL bypass.
    const readArgs = ['--agent-profile', AGENT_PROFILE, '--read-page', normalized];
    if (args.project) readArgs.push('--project', String(args.project));
    return await runRequired(ENRICH(), readArgs);
  }
  if (name === 'find_related') {
    // A single global Graphify output can expose restricted node names and
    // edges before page policy is applied. Governance v1 therefore uses only
    // the policy-filtered lexical path; a later partitioned graph may opt in.
    return await runRequired(ENRICH(), ['--agent-profile', AGENT_PROFILE, '--query', String(args.topic || ''), '--limit', '5', '--max-chars', '2000']);
  }
  if (name === 'list_recent_raw') {
    throw new Error('raw listing is disabled for Agent MCP profiles; run llm-wiki-review as the human owner');
  }
  if (name === 'record_event') {
    // 前置校验 type 白名单（与 llm-wiki-event 的 EVENT_TYPES 对齐），
    // 给出友好错误而非依赖 CLI argparse 的栈式报错。
    const TYPES = ['fact', 'decision', 'bug', 'workflow', 'preference', 'architecture', 'touch', 'lesson', 'session'];
    const t = String(args.type || '');
    if (!TYPES.includes(t)) throw new Error(`invalid type: ${t} (allowed: ${TYPES.join(', ')})`);
    const summary = String(args.summary || '').trim();
    if (!summary) throw new Error('summary is required');
    const a = [
      '--type', t,
      '--source', `mcp:${AGENT_PROFILE}`,
      '--actor-type', 'ai',
      '--actor-id', AGENT_PROFILE,
      '--domain', MEMORY_DOMAIN,
      '--sensitivity', 'internal',
      '--epistemic-status', 'ai-proposed',
      '--review-status', 'pending',
    ];
    for (const target of TARGET_AGENTS) a.push('--target-agent', target);
    if (args.details) a.push('--details', String(args.details));
    if (args.project) a.push('--project', String(args.project));
    if (args.validFrom) a.push('--valid-from', String(args.validFrom));
    if (args.validUntil) a.push('--valid-until', String(args.validUntil));
    if (args.supersedes !== undefined && !Array.isArray(args.supersedes)) throw new Error('supersedes must be an array');
    for (const eventId of (args.supersedes || [])) {
      const normalized = String(eventId);
      if (!/^[0-9a-f]{16}$/.test(normalized)) throw new Error(`invalid supersedes id: ${normalized}`);
      a.push('--supersedes', normalized);
    }
    a.push(summary);
    return await runRequired(EVENT(), a);
  }
  if (name === 'lint') {
    throw new Error('repository-wide lint is disabled for Agent MCP profiles; run llm-wiki-health as the human owner');
  }
  throw new Error(`Unknown tool: ${name}`);
}

// 传输框架：MCP stdio 规范（2025-06-18）用换行分隔 JSON（NDJSON），
// 且 Codex CLI 只按 '\n' 定界；而部分客户端沿用 LSP 风格 Content-Length 帧。
// 两者都要支持，否则任一侧会静默挂起（不匹配时既无报错也无提示）。
// 策略：按首个非空字节判定入向框架（'{' => NDJSON，否则按 header 解析），
// 出向镜像入向，未判定前默认 NDJSON（规范默认，也是 Codex 唯一支持的）。
const FRAMING = { NDJSON: 'ndjson', HEADER: 'header' };
let framing = null;
const MAX_LINE_BYTES = 8 * 1024 * 1024;

let buffer = Buffer.alloc(0);
process.stdin.on('data', (chunk) => { buffer = Buffer.concat([buffer, chunk]); readMessages(); });
process.on('SIGTERM', () => process.exit(0));
process.on('SIGINT', () => process.exit(0));

function detectFraming() {
  for (let i = 0; i < buffer.length; i += 1) {
    const b = buffer[i];
    if (b === 0x20 || b === 0x09 || b === 0x0a || b === 0x0d) continue;
    return b === 0x7b ? FRAMING.NDJSON : FRAMING.HEADER;
  }
  return null;
}

function readMessages() {
  while (true) {
    if (framing === null) {
      framing = detectFraming();
      if (framing === null) return;
    }
    const consumed = framing === FRAMING.NDJSON ? readOneNdjson() : readOneHeaderFramed();
    if (!consumed) return;

  }
}

function readOneNdjson() {
  const nl = buffer.indexOf(0x0a);
  if (nl === -1) {
    if (buffer.length > MAX_LINE_BYTES) {
      sendError(null, -32700, 'Message exceeds maximum line length');
      buffer = Buffer.alloc(0);
    }
    return false;
  }
  const line = buffer.subarray(0, nl).toString('utf8').trim();
  buffer = buffer.subarray(nl + 1);
  if (line) decodeAndHandle(line);
  return true;
}

function readOneHeaderFramed() {
  const headerEnd = buffer.indexOf('\r\n\r\n');
  if (headerEnd === -1) return false;
  const header = buffer.subarray(0, headerEnd).toString('utf8');
  const m = header.match(/Content-Length:\s*(\d+)/i);
  if (!m) { buffer = buffer.subarray(headerEnd + 4); return true; }
  const bodyStart = headerEnd + 4;
  const bodyEnd = bodyStart + Number(m[1]);
  if (buffer.length < bodyEnd) return false;
  const body = buffer.subarray(bodyStart, bodyEnd).toString('utf8');
  buffer = buffer.subarray(bodyEnd);
  decodeAndHandle(body);
  return true;
}

function decodeAndHandle(raw) {
  try { handleMessage(JSON.parse(raw)); }
  catch (e) { sendError(null, -32700, e instanceof Error ? e.message : 'Parse error'); }
}

function send(message) {
  const body = JSON.stringify(message);
  if (framing === FRAMING.HEADER) {
    process.stdout.write(`Content-Length: ${Buffer.byteLength(body, 'utf8')}\r\n\r\n${body}`);
  } else {
    process.stdout.write(`${body}\n`);
  }
}
const sendResult = (id, result) => send({ jsonrpc: '2.0', id, result });
const sendError = (id, code, message) => send({ jsonrpc: '2.0', id, error: { code, message } });

function handleMessage(message) {
  if (message.jsonrpc !== '2.0') {
    if (message.id !== undefined) sendError(message.id, -32600, 'Invalid JSON-RPC version');
    return;
  }
  if (message.method === 'initialize') {
    sendResult(message.id, {
      protocolVersion: '2024-11-05',
      capabilities: { tools: {} },
      serverInfo: { name: 'wikified', version: '0.1.0' },
    });
    return;
  }
  if (message.method === 'notifications/initialized') return;
  if (message.method === 'tools/list') { sendResult(message.id, { tools }); return; }
  if (message.method === 'tools/call') {
    const { name, arguments: args = {} } = message.params || {};
    dispatch(name, args)
      .then((text) => sendResult(message.id, { content: [{ type: 'text', text: String(text) }] }))
      .catch((e) => sendError(message.id, -32000, e instanceof Error ? e.message : String(e)));
    return;
  }
  if (message.id !== undefined) sendError(message.id, -32601, `Unsupported method: ${message.method}`);
}
