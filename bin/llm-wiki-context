#!/usr/bin/env python3
"""Prepare bounded, version-pinned context from existing assistant authority only."""
import argparse
import contextlib
import io
import json
import os
from pathlib import Path
import re
import runpy
import sys

sys.dont_write_bytecode = True
ENGINE = runpy.run_path(str(Path(__file__).with_name("llm-wiki-enrich")), run_name="context_engine")
MAX_SELECTIONS = 20
MAX_TEXT = 40000
MAX_ITEM_TEXT = 12000
REVISION = re.compile(r"^sha256:[0-9a-f]{64}$")
PROFILES = ("coding", "codex", "opencode", "claude", "cursor", "grok", "planning", "reflection")


def request(value):
    if not isinstance(value, dict) or set(value) != {"schemaVersion", "selections"} or type(value["schemaVersion"]) is not int or value["schemaVersion"] != 1:
        raise ValueError("invalid context request")
    rows = value["selections"]
    if not isinstance(rows, list) or not 1 <= len(rows) <= MAX_SELECTIONS:
        raise ValueError("invalid context selection")
    seen = set()
    for row in rows:
        if (not isinstance(row, dict) or set(row) != {"kind", "memoryId", "revision"}
                or row["kind"] not in ("page", "event")
                or not isinstance(row["memoryId"], str) or not ENGINE["MEMORY_ID_RE"].fullmatch(row["memoryId"])
                or ENGINE["redact"](row["memoryId"]) != row["memoryId"]
                or not isinstance(row["revision"], str) or not REVISION.fullmatch(row["revision"])
                or row["memoryId"] in seen):
            raise ValueError("invalid context selection")
        seen.add(row["memoryId"])
    return rows


def catalog(root, profile):
    if profile not in PROFILES:
        raise ValueError("assistant profile required")
    root = root.absolute()
    if root.resolve(strict=True) != root:
        raise ValueError("unsafe root")
    access = ENGINE["access_context"](root, profile)
    # The engine performs complete discovery, duplicate detection, authorization,
    # review bindings and source freshness before returning any page body.
    pages = ENGINE["page_snapshots"](root, access, None)
    before_events = ENGINE["_event_manifest"](root / "memory/events")
    with contextlib.redirect_stderr(io.StringIO()):
        events = ENGINE["load_events"](root, access)
    available = {}
    def add(identity, entry):
        if not isinstance(identity, str) or not ENGINE["MEMORY_ID_RE"].fullmatch(identity) or ENGINE["redact"](identity) != identity or identity in available:
            raise ValueError("ambiguous current identity")
        available[identity] = entry
    for entry, snapshot in pages:
        if snapshot.metadata.governance["review_status"] != "approved":
            continue
        # Topics only persist explicit identities, so renames do not change
        # their meaning. Path-derived legacy identities are not silently adopted.
        identity = snapshot.metadata.frontmatter.get("memory_id")
        if not isinstance(identity, str):
            continue
        add(identity, ("page", ENGINE["page_revision"](snapshot), entry.relative,
                       ENGINE["redact"](ENGINE["projected_page_text"](snapshot))))
    for event in events:
        if event["__governance"]["review_status"] != "approved":
            continue
        identity = event.get("record_id", event.get("memory_id", event.get("__memory_id")))
        if not isinstance(identity, str) or not ENGINE["MEMORY_ID_RE"].fullmatch(identity):
            raise ValueError("invalid identity")
        event_id = event.get("id")
        if not isinstance(event_id, str) or not re.fullmatch(r"[0-9a-f]{16}", event_id):
            continue
        add(identity, ("event", ENGINE["EVENT_REVIEW"]["record_revision"](event), event_id,
                       ENGINE["redact"](str(event.get("summary", "")) + "\n" + str(event.get("details", "")))))
    return root, access, pages, before_events, events, available


def verify_catalog(snapshot):
    root, _, pages, before_events, _, _ = snapshot
    if before_events != ENGINE["_event_manifest"](root / "memory/events"):
        raise ValueError("events changed")
    pages.verify()


def selected(selection, available):
    current = available.get(selection["memoryId"])
    item = {"selection": dict(selection), "status": "unavailable"}
    if current is None or current[0] != selection["kind"]:
        return item, None
    _, revision, locator, _ = current
    if ENGINE["redact"](locator) != locator:
        raise ValueError("unsafe metadata")
    if revision != selection["revision"]:
        return {**item, "status": "changed", "currentRevision": revision}, None
    return item, current


def prepare(root, profile, value):
    selections = request(value)
    snapshot = catalog(root, profile)
    available = snapshot[-1]
    items, used = [], 0
    for selection in selections:
        item, current = selected(selection, available)
        if current is not None:
            kind, revision, locator, text = current
            if len(text) > MAX_ITEM_TEXT or used + len(text) > MAX_TEXT:
                item = {**item, "status": "too-large"}
            else:
                item = {**item, "status": "ready", "locator": locator, "text": text}
                used += len(text)
        items.append(item)
    # Fence the entire result, not just each individual read. Never return a
    # partial pack after a policy, file, source-review or event generation race.
    verify_catalog(snapshot)
    return {"schemaVersion": 1, "profile": profile, "items": items}


def body_text(text):
    # An extract of already-authorized, fully redacted original text, never an
    # AI summary or a separate approved fact. Hide frontmatter from this view.
    if text.startswith("---\n") and "\n---\n" in text[4:]:
        text = text.split("\n---\n", 1)[1]
    return text.strip()


def excerpt(text, maximum):
    return body_text(text)[:maximum]


def preview(root, profile, value):
    selections = request(value)
    snapshot = catalog(root, profile)
    items = []
    for selection in selections:
        item, current = selected(selection, snapshot[-1])
        if current is not None:
            _, _, locator, text = current
            item = {**item, "status": "ready", "locator": locator, "excerpt": excerpt(text, 600), "totalChars": len(text)}
        items.append(item)
    verify_catalog(snapshot)
    return {"schemaVersion": 1, "profile": profile, "items": items}


def search(root, profile, value):
    if (not isinstance(value, dict) or not {"schemaVersion", "query"} <= set(value)
            or set(value) - {"schemaVersion", "query", "project", "limit"}
            or type(value["schemaVersion"]) is not int or value["schemaVersion"] != 1):
        raise ValueError("invalid search request")
    query, project, limit = value["query"], value.get("project"), value.get("limit", 6)
    if (not isinstance(query, str) or not query.strip() or len(query) > 500 or "\0" in query
            or ("project" in value and (not isinstance(project, str) or not project.strip() or len(project) > 160 or "\0" in project))
            or type(limit) is not int or not 1 <= limit <= 10):
        raise ValueError("invalid search request")
    snapshot = catalog(root, profile)
    root, access, _, _, events, available = snapshot
    terms = ENGINE["token_terms"]([query])
    groups = ENGINE["query_term_groups"]([query])
    candidates = ENGINE["event_candidates"](events, set(terms), groups, [], project)
    candidates.extend(ENGINE["wiki_candidates"](root, query, terms, groups, access, project))
    # Re-resolve every hit against the same authorized, approved identity map.
    # Path-derived legacy identities and graph-only hints cannot be selected.
    aliases = {event.get("__memory_id"): event.get("record_id", event.get("memory_id", event.get("__memory_id"))) for event in events}
    items, seen = [], set()
    for candidate in sorted(candidates, key=lambda item: item.score, reverse=True):
        identity = aliases.get(candidate.memory_id, candidate.memory_id) if candidate.source == "memory-event" else candidate.memory_id
        current = available.get(identity)
        if current is None or identity in seen:
            continue
        seen.add(identity)
        kind, revision, locator, text = current
        if ENGINE["redact"](locator) != locator:
            raise ValueError("unsafe metadata")
        items.append({"selection": {"kind": kind, "memoryId": identity, "revision": revision},
                      "title": ENGINE["redact"](candidate.title)[:160],
                      # Find the relevant passage only after full redaction;
                      # an excerpt boundary must not split and expose a secret.
                      "excerpt": ENGINE["extract_excerpt"](body_text(text), set(terms))[:400]})
    verify_catalog(snapshot)
    return {"schemaVersion": 1, "profile": profile, "items": items[:limit], "coverage": "limited" if len(items) > limit else "complete"}


def read_evidence(root, profile, value):
    if (not isinstance(value, dict) or not {"schemaVersion", "selection"} <= set(value)
            or set(value) - {"schemaVersion", "selection", "offset", "length"}):
        raise ValueError("invalid evidence request")
    selection = request({"schemaVersion": value["schemaVersion"], "selections": [value["selection"]]})[0]
    offset, length = value.get("offset", 0), value.get("length", 4000)
    if type(offset) is not int or offset < 0 or type(length) is not int or not 1 <= length <= 8000:
        raise ValueError("invalid evidence request")
    snapshot = catalog(root, profile)
    item, current = selected(selection, snapshot[-1])
    if current is not None:
        kind, revision, locator, text = current
        if offset > len(text):
            raise ValueError("invalid evidence offset")
        if kind == "page":
            raw = ENGINE["read_page"](snapshot[0], locator, snapshot[1], None, offset=offset, length=length, revision=revision)
            if raw is None:
                raise ValueError("evidence changed")
            chunk = json.loads(raw)
            if chunk["memory_id"] != selection["memoryId"] or chunk["revision"] != revision or chunk["totalChars"] != len(text):
                raise ValueError("evidence changed")
            content, end = chunk["text"], chunk["nextOffset"]
        else:
            content = text[offset:offset + length]
            end = offset + len(content) if offset + len(content) < len(text) else None
        item = {**item, "status": "ready", "locator": locator, "text": content,
                "offset": offset, "nextOffset": end, "totalChars": len(text)}
    verify_catalog(snapshot)
    return {"schemaVersion": 1, "profile": profile, "item": item}


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError("invalid arguments")


def main():
    parser = Parser(allow_abbrev=False)
    parser.add_argument("--root", default=os.environ.get("LLM_WIKI_ROOT", str(Path.home() / "llm-wiki")))
    parser.add_argument("--agent-profile", required=True, choices=PROFILES)
    parser.add_argument("--request", required=True)
    parser.add_argument("--operation", choices=("prepare", "search", "preview", "read"), default="prepare")
    for flag in ("--root", "--agent-profile", "--request", "--operation"):
        if sum(arg == flag or arg.startswith(flag + "=") for arg in sys.argv[1:]) > 1:
            raise ValueError("duplicate argument")
    args = parser.parse_args()
    if len(args.request.encode("utf-8")) > 16384:
        raise ValueError("request too large")
    value = json.loads(args.request, object_pairs_hook=ENGINE["_event_json_object"],
                       parse_constant=ENGINE["_event_json_constant"])
    result = {"prepare": prepare, "search": search, "preview": preview, "read": read_evidence}[args.operation](Path(args.root), args.agent_profile, value)
    print(json.dumps(result, ensure_ascii=False, allow_nan=False))


if __name__ == "__main__":
    try:
        main()
    except (Exception, RecursionError):
        print("context unavailable; refresh the selection and retry", file=sys.stderr)
        sys.exit(1)
