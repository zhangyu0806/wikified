#!/usr/bin/env python3
"""Opt-in local human review CLI. No MCP review tool; no default migration."""
from __future__ import annotations
import argparse
from datetime import datetime, timezone
import hmac
import json
import os
from pathlib import Path
import runpy
import stat
import sys
import uuid

BIN = Path(__file__).resolve().parent
CORE = runpy.run_path(str(BIN / "llm_wiki_event_review.py"))
ENGINE = runpy.run_path(str(BIN / "llm-wiki-enrich"), run_name="event_review_reader")
WRITER = runpy.run_path(str(BIN / "llm-wiki-event"), run_name="event_review_writer")


def source_selection(pages, bindings, target_identity):
    available = {page.metadata.memory_id: page for _, page in pages
                 if (page.metadata.frontmatter or {}).get("memory_id")}
    nodes = {node["id"]: node for node in pages.source_nodes}
    for binding in bindings:
        page = available.get(binding["id"])
        if page is None or ENGINE["page_revision"](page) != binding["revision"]:
            raise ValueError("source unavailable or changed")
        # A new revision would invalidate a source that depends on the event
        # being reviewed, even when its current exact revision is still valid.
        # Check before append, using the same bounded cross-type graph.
        pending, visited = [(binding["id"], 0)], set()
        while pending:
            identity, depth = pending.pop()
            if identity == target_identity:
                raise ValueError("source depends on reviewed event")
            if depth > ENGINE["SOURCE_FRESHNESS"]["LIMITS"]["depth"]:
                raise ValueError("source graph limit")
            if identity in visited:
                continue
            visited.add(identity)
            if len(visited) > ENGINE["SOURCE_FRESHNESS"]["LIMITS"]["visited"]:
                raise ValueError("source graph limit")
            node = nodes.get(identity)
            if node is None:
                raise ValueError("source unavailable")
            for source in node.get("sources") or []:
                if source.get("relation") == "current-derived":
                    pending.append((source["id"], depth + 1))


class ExpectedAppend:
    """Only the writer's exact append may advance an observed event set."""
    def __init__(self, root, manifest, path, line):
        self.root, self.directory, self.path = root, path.parent, path
        self.before, self.line = manifest, line
        self.entries = self.directory_entries()
        self.parent = ENGINE["_event_parent_signature"](root)
        self.prior = b""
        expected = manifest[1].get(path.name)
        if expected is not None:
            with os.fdopen(os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)), "rb") as handle:
                if ENGINE["_event_stat_signature"](os.fstat(handle.fileno())) != expected:
                    raise ValueError("event output changed")
                self.prior = handle.read(ENGINE["MAX_EVENT_TOTAL_BYTES"] + 1)
                if len(self.prior) != expected[4] or ENGINE["_event_stat_signature"](os.fstat(handle.fileno())) != expected:
                    raise ValueError("event output changed")
        if ENGINE["_event_manifest"](self.directory) != manifest:
            raise ValueError("event directory changed")

    def opened(self, info):
        current = ENGINE["_event_manifest"](self.directory)
        expected_files = {**self.before[1], self.path.name: ENGINE["_event_stat_signature"](info)}
        if (current[1] != expected_files or current[0][:3] != self.before[0][:3]
            or self.directory_entries() != self.entries | {self.path.name}
            or ENGINE["_event_parent_signature"](self.root) != self.parent
            or (self.path.name in self.before[1] and current[0] != self.before[0])):
            raise ValueError("event directory changed")
        self.directory_signature = current[0]
        self.file_identity = ENGINE["_event_stat_signature"](info)[:4]

    def directory_entries(self):
        names = set()
        with os.scandir(self.directory) as entries:
            for entry in entries:
                names.add(entry.name)
                if len(names) > ENGINE["MAX_EVENT_DIRECTORY_ENTRIES"]:
                    raise ValueError("event directory entry limit")
        return frozenset(names)

    def written(self, info):
        signature = ENGINE["_event_stat_signature"](info)
        if signature[:4] != self.file_identity or signature[4] != len(self.prior) + len(self.line):
            raise ValueError("unexpected event append")
        self.expected = (self.directory_signature, {**self.before[1], self.path.name: signature})
        self.verify()

    def verify(self):
        if (ENGINE["_event_parent_signature"](self.root) != self.parent
            or ENGINE["_event_manifest"](self.directory) != self.expected):
            raise ValueError("unexpected event append")
        with os.fdopen(os.open(self.path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)), "rb") as handle:
            signature = self.expected[1][self.path.name]
            if (ENGINE["_event_stat_signature"](os.fstat(handle.fileno())) != signature
                or handle.read(ENGINE["MAX_EVENT_TOTAL_BYTES"] + 1) != self.prior + self.line
                or ENGINE["_event_stat_signature"](os.fstat(handle.fileno())) != signature):
                raise ValueError("unexpected event append")
        if ENGINE["_event_manifest"](self.directory) != self.expected:
            raise ValueError("unexpected event append")


def snapshot(root):
    rows = ENGINE["_read_event_snapshot"](root)
    now = datetime.now(timezone.utc)
    edges = ENGINE["_event_terminal_edges"](rows, now)
    return [CORE["clean"](e) for e in rows], {i for ids in edges.values() for i in ids}

def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--inspect", metavar="EVENT_ID", help="Read one current local event and its CAS revision; does not approve or write.")
    args = parser.parse_args(argv)
    root_value = os.environ.get("LLM_WIKI_ROOT")
    if not root_value:
        raise ValueError("explicit LLM_WIKI_ROOT required")
    root = Path(root_value).expanduser().resolve(strict=True)
    if args.inspect:
        rows, closed = snapshot(root)
        target = next((e for e in rows if e.get("id") == args.inspect), None)
        if target is None or args.inspect in closed or target.get("lifecycle", "active") != "active":
            raise ValueError("event is not current")
        print(json.dumps({"event":target,"expected_revision":CORE["record_revision"](target)}, ensure_ascii=False, allow_nan=False))
        return 0
    # Authority is server/operator configuration, never actor JSON supplied by a caller.
    configured = os.environ.get("LLM_WIKI_EVENT_REVIEW_CAPABILITY", "")
    actor_id = os.environ.get("LLM_WIKI_EVENT_REVIEW_ACTOR", "")
    if not (32 <= len(configured) <= 512) or not configured.isascii() or not all(33 <= ord(c) <= 126 for c in configured) or not CORE["IDENTIFIER"].fullmatch(actor_id):
        raise ValueError("independent local review authority is not configured")
    raw = sys.stdin.buffer.read(128 * 1024 + 1)
    if len(raw) > 128 * 1024:
        raise ValueError("review request exceeds limit")
    request = json.loads(raw.decode("utf-8"), object_pairs_hook=ENGINE["_event_json_object"], parse_constant=ENGINE["_event_json_constant"])
    supplied = request.get("capability") if isinstance(request, dict) else None
    if not isinstance(supplied, str) or not supplied.isascii() or not hmac.compare_digest(configured, supplied):
        raise ValueError("independent local review capability required")
    # The capability is never part of hashes, output, history or error text.
    request = {k:v for k,v in request.items() if k != "capability"}
    if WRITER["redact"](request) != request:
        raise ValueError("review input contains material requiring redaction; inspect a redacted proposal first")
    memory = root / "memory"
    before = memory.lstat()
    if not stat.S_ISDIR(before.st_mode):
        raise ValueError("unsafe memory directory")
    lock_path = memory / ".memory.lock"
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
    with os.fdopen(fd, "r+", encoding="utf-8") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode) or os.fstat(handle.fileno()).st_nlink != 1:
            raise ValueError("unsafe memory lock")
        WRITER["lock_memory"](handle)
        try:
            if (memory.lstat().st_dev, memory.lstat().st_ino) != (before.st_dev, before.st_ino):
                raise ValueError("memory directory changed")
            lock_signature = ENGINE["_event_stat_signature"](os.fstat(handle.fileno()))
            def verify_source_review_lock():
                # Source-review uses the same POSIX lock. A second descriptor
                # cannot acquire a shared lock while this writer owns LOCK_EX.
                # Reassert and verify the existing descriptor instead.
                fcntl = WRITER["fcntl"]
                if os.name != "posix" or fcntl is None:
                    raise ValueError("source review requires POSIX locking")
                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                if ((memory.lstat().st_dev, memory.lstat().st_ino) != (before.st_dev, before.st_ino)
                    or ENGINE["_event_stat_signature"](os.fstat(handle.fileno())) != lock_signature
                    or ENGINE["_event_stat_signature"](lock_path.lstat()) != lock_signature):
                    raise ValueError("source review lock changed")
            rows, closed = snapshot(root)
            prior = next((e for e in rows if e.get("schema_version") in CORE["SCHEMAS"] and e["review"]["request_id"] == request.get("request_id")), None)
            if prior:
                if prior["id"] in closed or prior["review"]["request_revision"] != CORE["request_revision"](request) or prior["actor"]["id"] != actor_id:
                    raise ValueError("review retry conflicts with current state")
                print(json.dumps(prior, ensure_ascii=False, allow_nan=False))
                return 0
            target = next((e for e in rows if e.get("id") == request.get("target_id")), None)
            if target is None or target["id"] in closed or target.get("lifecycle", "active") != "active":
                raise ValueError("event is not current")
            now = datetime.now(timezone.utc)
            e = CORE["prepare"](target, request, actor_id=actor_id, can_review=True,
                now=now.isoformat(timespec="milliseconds").replace("+00:00", "Z"), event_id=uuid.uuid4().hex[:16])
            if WRITER["redact"](e) != e:
                raise ValueError("event requires redaction before review")
            if ENGINE["event_metadata"](e) is None:
                raise ValueError("invalid generated event governance")
            source_pages = None
            if "source_bindings" in request:
                # Only explicitly selected bindings are refreshed. Unselected
                # edges keep their reviewed revisions, including stale edges.
                access = ENGINE["access_context"](root, "human")
                if not ENGINE["is_authorized"](ENGINE["event_metadata"](e)[1], access):
                    raise ValueError("event unavailable to reviewer")
                source_pages = ENGINE["page_snapshots"](root, access, None, source_review_lock=verify_source_review_lock)
                source_selection(source_pages, CORE["source_bindings"](request["source_bindings"]), e["record_id"])
            CORE["validate_links"](rows + [e])
            # Verify inherited edges and cycles against the same locked snapshot.
            index = {r["id"]:r for r in rows}
            WRITER["validate_supersedes"](index, e["supersedes"], e["project"], e["domain"], allow_versioned=True)
            line = (json.dumps(e, ensure_ascii=False, separators=(",", ":"), allow_nan=False)+"\n").encode("utf-8")
            if len(line) > ENGINE["MAX_EVENT_LINE_BYTES"]:
                raise ValueError("review event exceeds line budget")
            directory = memory / "events"
            manifest = ENGINE["_event_manifest"](directory)
            path = directory / f"{now:%Y-%m}.jsonl"
            physical_lines = 0
            prefix = b""
            for name in manifest[1]:
                with (directory / name).open("rb") as prior_file:
                    last = b""
                    for last in prior_file:
                        physical_lines += 1
                    if name == path.name and last and not last.endswith(b"\n"):
                        if len(last)+1 > ENGINE["MAX_EVENT_LINE_BYTES"]:
                            raise ValueError("existing final line has no newline budget")
                        prefix = b"\n"
            line = prefix + line
            # Do not write a record that makes the next complete read exceed a bound.
            if sum(s[4] for s in manifest[1].values()) + len(line) > ENGINE["MAX_EVENT_TOTAL_BYTES"] or physical_lines+1 > ENGINE["MAX_EVENT_LINES"]:
                raise ValueError("review exceeds snapshot budget")
            if path.name not in manifest[1] and len(manifest[1]) >= ENGINE["MAX_EVENT_FILES"]:
                raise ValueError("event file limit")
            if path.name not in manifest[1] and sum(1 for _ in directory.iterdir()) >= ENGINE["MAX_EVENT_DIRECTORY_ENTRIES"]:
                raise ValueError("event directory entry limit")
            if ENGINE["_event_manifest"](directory) != manifest:
                raise ValueError("event directory changed")
            if source_pages is not None:
                source_pages.verify()
            expected_append = ExpectedAppend(root, manifest, path, line) if source_pages is not None else None
            flags = os.O_WRONLY | os.O_APPEND | getattr(os,"O_NOFOLLOW",0)
            if path.name not in manifest[1]:
                flags |= os.O_CREAT | os.O_EXCL
            descriptor = os.open(path, flags, 0o600)
            with os.fdopen(descriptor,"ab") as output:
                info = os.fstat(output.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                    raise ValueError("unsafe event output")
                if path.name in manifest[1] and ENGINE["_event_stat_signature"](info) != manifest[1][path.name]:
                    raise ValueError("event output changed")
                if source_pages is not None:
                    expected_append.opened(info)
                    # O_EXCL may have created this one empty output file. The
                    # exact event observation is now guarded by ExpectedAppend;
                    # all other authority stays at its original generation.
                    source_pages.generation.verify()
                output.write(line); output.flush(); os.fsync(output.fileno())
                if expected_append is not None:
                    expected_append.written(os.fstat(output.fileno()))
            if path.name not in manifest[1] and os.name == "posix":
                directory_fd = os.open(directory, os.O_RDONLY | getattr(os,"O_DIRECTORY",0) | getattr(os,"O_NOFOLLOW",0))
                try: os.fsync(directory_fd)
                finally: os.close(directory_fd)
            if source_pages is not None:
                source_pages.generation.verify()
                expected_append.verify()
                refreshed = ENGINE["page_snapshots"](root, access, None, source_review_lock=verify_source_review_lock)
                source_selection(refreshed, CORE["source_bindings"](request["source_bindings"]), e["record_id"])
                refreshed.verify()
                source_pages.generation.verify()
                expected_append.verify()
            print(json.dumps(e, ensure_ascii=False, allow_nan=False))
            return 0
        finally:
            WRITER["unlock_memory"](handle)

if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (ValueError, TypeError, KeyError, OSError, UnicodeError, OverflowError, RecursionError, ENGINE["EventSnapshotError"], ENGINE["PageSnapshotError"], ENGINE["PolicyError"]):
        # Never echo stdin, environment values, event text or paths.
        print("llm-wiki-event-review: review unavailable or conflicted; re-inspect current state and authority", file=sys.stderr)
        raise SystemExit(2)
