#!/usr/bin/env python3
"""Wikified 复盘入口 (human review dashboard) — 只读、聚合、给人看的。

这条命令回答一个问题：「我该看什么、堆了多久、从哪下手？」

设计原则（对标 open-zk-kb / ContextOS promotion-aware memory / GTD 周复盘）：
  - Advisory only. 本命令**从不**改 wiki/、events 或 corrections；它只聚合与建议。
    真正的晋升/拒绝/过期永远是人的显式动作（llm-wiki-correct --resolve、手动编译、
    手动移到 expired/）。这是信噪比与可审计性的来源。
  - 一个入口。把散落的四路——corrections 队列、promote 建议、未编译 raw、陈旧
    event——聚合成一份人类可读清单，末尾给「距上次复盘多久」的节奏提醒。
  - 每项给一个动作动词（GTD 四选一的简化）：晋升 / 归档 / 展开 / 丢弃。

用法：
  llm-wiki-review                 打印人类可读复盘清单，并更新 last-review 时间戳
  llm-wiki-review --json          机器可读聚合（供仪表盘/其他工具消费）
  llm-wiki-review --peek          只看不更新时间戳（不算作一次正式复盘）
  llm-wiki-review --expire-days N event 超过 N 天未更新即列为 expire 候选（默认按半衰期）
"""

from __future__ import annotations

import argparse
import json
import math
import os
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

DEFAULT_ROOT = Path(os.environ.get("LLM_WIKI_ROOT", str(Path.home() / "llm-wiki"))).expanduser()
# 复盘节奏：对标 GTD 周复盘。超过这个天数没复盘就在开头醒目提示。
REVIEW_CADENCE_DAYS = 7
# event expire 候选的默认判据：已过 N 个半衰期（confidence 衰减到 < 1/2^N）。
# 保守取 2 个半衰期——衰减到原值 1/4 以下，基本已不影响召回排序，适合复核去留。
DEFAULT_EXPIRE_HALFLIVES = 2.0


def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def parse_time(value: Any) -> datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def days_since(ts: datetime | None) -> float | None:
    if ts is None:
        return None
    return max(0.0, (now_utc() - ts).total_seconds() / 86400)


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    rows: list[dict[str, Any]] = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(item, dict):
            rows.append(item)
    return rows


def read_json(path: Path) -> Any:
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except json.JSONDecodeError:
        return None


# ---------- 四路聚合 ----------

def collect_corrections(root: Path) -> list[dict[str, Any]]:
    """pending 的用户纠正/偏好——最高优先级：这是你纠正过 AI、但可能还没生效的东西。"""
    rows = read_jsonl(root / "raw" / "inbox" / "corrections.jsonl")
    out: list[dict[str, Any]] = []
    for r in rows:
        if r.get("status") != "pending":
            continue
        out.append(
            {
                "id": r.get("id"),
                "kind": r.get("kind", "correction"),
                "text": r.get("text", ""),
                "age_days": days_since(parse_time(r.get("timestamp"))),
            }
        )
    out.sort(key=lambda x: x.get("age_days") or 0, reverse=True)
    return out


def collect_promote_suggestions(root: Path) -> list[dict[str, Any]]:
    """govern 每 7 天刷新的 promote 建议（quick-note + auto-draft）。"""
    data = read_json(root / "raw" / "inbox" / "promote-suggestions.json")
    if not isinstance(data, list):
        return []
    order = {"high": 0, "medium": 1, "low": 2}
    rows = [r for r in data if isinstance(r, dict)]
    rows.sort(key=lambda x: order.get(str(x.get("confidence", "low")), 3))
    return rows


def raw_title(text: str, frontmatter: dict[str, str], fallback: str) -> str:
    """人类可读标题：frontmatter title > 首个 markdown 一级标题 > 文件名。

    文件名是 slug（如 2026-05-23-bilibili-bv1gglr6geer-...），复盘时无法据此判断
    内容价值，所以必须给出真标题。
    """
    if frontmatter.get("title"):
        return frontmatter["title"].strip().strip('"').strip("'")
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("#"):
            return stripped.lstrip("#").strip()[:120]
    return fallback


def collect_uncompiled_raw(root: Path) -> list[dict[str, Any]]:
    """raw/ 里还没编译进 wiki 的源材料（frontmatter status 未标 compiled/promoted/archived）。"""
    raw_dir = root / "raw"
    if not raw_dir.exists():
        return []
    done = {"compiled", "promoted", "archived"}
    out: list[dict[str, Any]] = []
    for path in sorted(raw_dir.rglob("*.md")):
        if not path.is_file() or path.name.startswith("."):
            continue
        # inbox/auto-drafts 已由 promote-suggestions 覆盖，这里不重复计。
        rel = path.relative_to(raw_dir).as_posix()
        if rel.startswith("inbox/"):
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        frontmatter: dict[str, str] = {}
        if text.startswith("---\n"):
            end = text.find("\n---\n", 4)
            if end != -1:
                for line in text[4:end].splitlines():
                    if ":" in line:
                        key, value = line.split(":", 1)
                        frontmatter[key.strip().lower()] = value.strip()
        if frontmatter.get("status", "").strip().strip('"').lower() in done:
            continue
        try:
            mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
        except OSError:
            mtime = None
        out.append(
            {
                "path": rel,
                "title": raw_title(text, frontmatter, path.stem),
                "category": rel.split("/", 1)[0],
                "age_days": days_since(mtime),
            }
        )
    out.sort(key=lambda x: x.get("age_days") or 0, reverse=True)
    return out


def decayed_confidence(event: dict[str, Any], half_lives: float) -> tuple[float, float | None]:
    """返回 (当前衰减置信, 已过半衰期数)。用于挑选 expire 候选。"""
    try:
        base = float(event.get("confidence", 0.5))
    except (TypeError, ValueError):
        base = 0.5
    try:
        half_life = max(1.0, float(event.get("half_life_days", 90)))
    except (TypeError, ValueError):
        half_life = 90.0
    ts = parse_time(event.get("valid_from") or event.get("timestamp"))
    age = days_since(ts)
    if age is None:
        return base, None
    lives_passed = age / half_life
    return base * math.pow(0.5, lives_passed), lives_passed


def collect_stale_events(root: Path, half_lives: float) -> tuple[dict[str, int], list[dict[str, Any]]]:
    """统计 event 堆积，并挑出已过 `half_lives` 个半衰期的陈旧项作为 expire 候选。

    只列 active（未 deprecated / 未被 supersede）的 event，避免建议已经失效的项。
    """
    events_dir = root / "memory" / "events"
    counts: dict[str, int] = {}
    stale: list[dict[str, Any]] = []
    if not events_dir.exists():
        return counts, stale

    all_rows: list[dict[str, Any]] = []
    superseded: set[str] = set()
    for path in sorted(events_dir.glob("*.jsonl")):
        month = path.stem
        rows = read_jsonl(path)
        counts[month] = len(rows)
        for r in rows:
            all_rows.append(r)
            targets = r.get("supersedes", [])
            if isinstance(targets, str):
                targets = [targets]
            if isinstance(targets, list):
                superseded.update(str(t) for t in targets if isinstance(t, str))

    for r in all_rows:
        if r.get("lifecycle", "active") == "deprecated":
            continue
        if str(r.get("id", "")) in superseded:
            continue
        conf, lives = decayed_confidence(r, half_lives)
        if lives is None or lives < half_lives:
            continue
        stale.append(
            {
                "id": r.get("id"),
                "type": r.get("type", "event"),
                "project": r.get("project"),
                "summary": str(r.get("summary", ""))[:100],
                "age_days": days_since(parse_time(r.get("valid_from") or r.get("timestamp"))),
                "decayed_confidence": round(conf, 4),
                "half_lives_passed": round(lives, 2),
            }
        )
    stale.sort(key=lambda x: x.get("half_lives_passed") or 0, reverse=True)
    return counts, stale


# ---------- 节奏时间戳 ----------

def stamp_path(root: Path) -> Path:
    return root / "wiki" / "dashboards" / ".last-review"


def read_last_review(root: Path) -> datetime | None:
    p = stamp_path(root)
    if not p.exists():
        return None
    return parse_time(p.read_text(encoding="utf-8", errors="replace").strip())


def write_last_review(root: Path) -> None:
    p = stamp_path(root)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(now_utc().isoformat() + "\n", encoding="utf-8")


# ---------- 渲染 ----------

def build_report(root: Path, half_lives: float) -> dict[str, Any]:
    counts, stale = collect_stale_events(root, half_lives)
    return {
        "generated_at": now_utc().isoformat(),
        "last_review_days_ago": days_since(read_last_review(root)),
        "cadence_days": REVIEW_CADENCE_DAYS,
        "corrections_pending": collect_corrections(root),
        "promote_suggestions": collect_promote_suggestions(root),
        "uncompiled_raw": collect_uncompiled_raw(root),
        "event_counts": counts,
        "event_total": sum(counts.values()),
        "expire_candidates": stale,
    }


def fmt_age(days: float | None) -> str:
    if days is None:
        return "?"
    if days < 1:
        return "今天"
    return f"{int(days)}天前"


def memory_rel_path(value: Any) -> str | None:
    text = str(value or "").replace("\\", "/")
    for marker in ("raw/", "wiki/"):
        idx = text.find(marker)
        if idx != -1:
            return text[idx:]
    return None


def obsidian_link(value: Any, *, raw_relative: bool = False) -> str:
    rel = memory_rel_path(value)
    if rel is None and raw_relative:
        rel = "raw/" + str(value or "").lstrip("/")
    if rel is None:
        return f"`{value}`"
    rel = rel.strip()
    mirrored = rel.startswith(("wiki/", "raw/notes/", "raw/sessions/", "raw/articles/"))
    if not mirrored or not rel.endswith(".md"):
        return f"`{value}`"
    target = rel[:-3]
    return f"[[{target}|{Path(rel).stem}]]"


def render_markdown(report: dict[str, Any]) -> str:
    lines: list[str] = []
    last = report["last_review_days_ago"]
    if last is None:
        header_note = "⚠️  从未做过复盘 — 这是第一次"
    elif last >= report["cadence_days"]:
        header_note = f"⚠️  距上次复盘 {int(last)} 天（超过 {report['cadence_days']} 天节奏）"
    else:
        header_note = f"距上次复盘 {int(last)} 天"

    lines.append("# Wikified 复盘清单")
    lines.append("")
    lines.append(f"> {header_note}")
    lines.append("> 本清单只读、只建议。晋升/拒绝/过期都要你显式动手——这是信噪比来源。")
    lines.append("> 每项四选一：**晋升**(编译进 wiki) / **归档**(留档不编译) / **展开**(值得深挖) / **丢弃**。")
    lines.append("")

    # 1. corrections —— 最高优先级
    corr = report["corrections_pending"]
    lines.append(f"## 1. 待处理的纠正/偏好（{len(corr)} 条）— 最高优先级")
    lines.append("")
    if not corr:
        lines.append("_队列为空。_")
    else:
        lines.append("_你纠正过 AI 或表达过偏好，但还没进 wiki/CRITICAL_FACTS，AI 可能还在犯。_")
        lines.append("")
        for r in corr:
            lines.append(f"- `[{r['id']}]` ({r['kind']}, {fmt_age(r['age_days'])}) {r['text']}")
        lines.append("")
        lines.append("处理：`llm-wiki-correct --resolve <id>`（晋升后编译进 CRITICAL_FACTS/AGENTS.md）")
        lines.append("或 `llm-wiki-correct --resolve <id> --status rejected`（看过决定不要）。")
    lines.append("")

    # 2. 晋升建议
    promo = report["promote_suggestions"]
    lines.append(f"## 2. 晋升建议（{len(promo)} 条 quick-note / auto-draft）")
    lines.append("")
    if not promo:
        lines.append("_无。跑 `llm-wiki-govern --force` 可刷新建议。_")
    else:
        for r in promo:
            conf = r.get("confidence", "?")
            src = r.get("source", "?")
            lines.append(
                f"- [{conf}] {r.get('title', '(无标题)')} "
                f"→ `{r.get('suggested_target', '?')}` ({src})"
            )
            lines.append(f"    - {obsidian_link(r.get('note', ''))}")
    lines.append("")

    # 3. 未编译 raw
    raw = report["uncompiled_raw"]
    lines.append(f"## 3. 未编译的源材料（{len(raw)} 个 raw 文件）")
    lines.append("")
    if not raw:
        lines.append("_全部已编译或已归档。_")
    else:
        by_cat: dict[str, int] = {}
        for r in raw:
            by_cat[r["category"]] = by_cat.get(r["category"], 0) + 1
        lines.append("按类型：" + "，".join(f"{k} {v}" for k, v in sorted(by_cat.items())))
        lines.append("")
        lines.append("最久未动的前 10 个：")
        for r in raw[:10]:
            lines.append(f"- ({fmt_age(r['age_days'])}) {r.get('title', '')}")
            lines.append(f"    {obsidian_link(r['path'], raw_relative=True)}")
        if len(raw) > 10:
            lines.append(f"- …还有 {len(raw) - 10} 个")
    lines.append("")

    # 4. event 堆积 + expire 候选
    exp = report["expire_candidates"]
    lines.append(f"## 4. Event 堆积与过期候选（共 {report['event_total']} 条 event）")
    lines.append("")
    counts = report["event_counts"]
    if counts:
        lines.append("按月：" + "，".join(f"{m} {c}" for m, c in sorted(counts.items())))
        lines.append("")
    if not exp:
        lines.append("_无明显陈旧 event。_")
    else:
        lines.append(f"以下 {len(exp)} 条已过 ≥2 个半衰期（置信衰减到原值 1/4 以下），建议复核去留：")
        lines.append("")
        for r in exp[:15]:
            lines.append(
                f"- `[{r['id']}]` {r['type']}"
                + (f"/{r['project']}" if r.get("project") else "")
                + f" ({fmt_age(r['age_days'])}, 置信→{r['decayed_confidence']}) {r['summary']}"
            )
        if len(exp) > 15:
            lines.append(f"- …还有 {len(exp) - 15} 条")
        lines.append("")
        lines.append("过期处理：确认无用后，把对应 event 的 `lifecycle` 手动改为 `deprecated`，")
        lines.append("或用新事实 `llm-wiki-event --supersedes <id>` 取代（不删，留档）。")
    lines.append("")

    return "\n".join(lines).rstrip() + "\n"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Wikified 复盘入口：聚合待审内容，只读只建议。")
    parser.add_argument("--root", default=str(DEFAULT_ROOT), help="Wikified 数据根目录")
    parser.add_argument("--json", action="store_true", help="输出机器可读 JSON")
    parser.add_argument("--peek", action="store_true", help="只看不更新 last-review 时间戳")
    parser.add_argument(
        "--expire-days",
        type=float,
        default=None,
        help="event 超过 N 天未更新即列为 expire 候选（默认按半衰期判定）",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    root = Path(args.root).expanduser()
    if not (root / "SCHEMA.md").exists():
        print(f"error: 不是 Wikified 数据根（缺 SCHEMA.md）: {root}", file=sys.stderr)
        return 1

    half_lives = DEFAULT_EXPIRE_HALFLIVES
    report = build_report(root, half_lives)

    # --expire-days 覆盖半衰期判定：改用「绝对天数」阈值重算候选。
    if args.expire_days is not None:
        _, all_stale = collect_stale_events(root, 0.0)  # 拿全部 active event
        report["expire_candidates"] = [
            r for r in all_stale if (r.get("age_days") or 0) >= args.expire_days
        ]

    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        sys.stdout.write(render_markdown(report))

    # 正式复盘（非 --peek、非 --json）才更新节奏时间戳。
    if not args.peek and not args.json:
        write_last_review(root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
