#!/usr/bin/env python3
"""Capture a quick note into ~/llm-wiki/raw/notes, then refresh derived wiki pages."""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path


WIKI_ROOT = Path(os.environ.get("LLM_WIKI_ROOT", Path.home() / "llm-wiki")).expanduser()
NOTES_DIR = WIKI_ROOT / "raw" / "notes"

SECRET_PATTERNS: list[tuple[re.Pattern[str], str]] = [
    (re.compile(r"(?i)(authorization\s*[:=]\s*)(?:bearer\s+)?[^\s,'\"]+(?:\s+[a-z0-9._~+/=-]{8,})?"), r"\1[REDACTED]"),
    (re.compile(r"(?i)([\"']?(?:api[_-]?key|token|secret|password|passwd|pwd)[\"']?\s*[:=]\s*)([\"']?)[^\s,'\"&]+([\"']?)"), r"\1\2[REDACTED]\3"),
    (re.compile(r"(?i)([?&](?:api[_-]?key|token|secret|password|passwd|pwd)=)[^\s&#]+"), r"\1[REDACTED]"),
    (re.compile(r"(?i)bearer\s+[a-z0-9._~+/=-]{16,}"), "Bearer [REDACTED]"),
    (re.compile(r"\b(sk-[a-zA-Z0-9_-]{16,})\b"), "[REDACTED_OPENAI_KEY]"),
    (re.compile(r"\b(gh[pousr]_[a-zA-Z0-9_]{20,})\b"), "[REDACTED_GITHUB_TOKEN]"),
    (re.compile(r"\b(xox[baprs]-[a-zA-Z0-9-]{20,})\b"), "[REDACTED_SLACK_TOKEN]"),
    (re.compile(r"\b(eyJ[a-zA-Z0-9_-]{20,}\.[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,})\b"), "[REDACTED_JWT]"),
]


def redact(text: str) -> str:
    for pattern, replacement in SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text


def _resolve_refresh() -> str:
    """定位 llm-wiki-refresh。

    先看与本文件同目录的兄弟命令：软链安装后两者同在 BIN_TARGET 里，
    这样即使装到非默认位置也能自洽。其次认 LLM_WIKI_BIN_TARGET，
    最后交给 PATH 兜底。
    写死 ~/.local/bin 会导致自定义 BIN_TARGET 下静默跳过刷新——
    笔记落盘但派生页永不更新，且不报错。
    """
    name = "llm-wiki-refresh"
    candidates = [Path(__file__).resolve().parent]
    env_bin = os.environ.get("LLM_WIKI_BIN_TARGET")
    if env_bin:
        candidates.append(Path(env_bin).expanduser())
    candidates.append(Path.home() / ".local" / "bin")
    for d in candidates:
        p = d / name
        if p.exists():
            return str(p)
    return name


REFRESH_COMMAND = _resolve_refresh()


def slugify(text: str, fallback: str) -> str:
    ascii_text = text.encode("ascii", "ignore").decode("ascii").lower()
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_text).strip("-")
    return slug[:48].strip("-") or fallback


def yaml_quote(value: str) -> str:
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"') + '"'


def infer_note_type(text: str) -> str:
    lowered = text.lower()
    if any(keyword in text for keyword in ("坑", "报错", "失败", "bug", "问题")) or "error" in lowered:
        return "pitfall"
    if any(keyword in text for keyword in ("偏好", "以后", "默认", "喜欢")):
        return "preference"
    if any(keyword in text for keyword in ("待办", "todo", "要做", "记得")) or "todo" in lowered:
        return "todo"
    if any(keyword in text for keyword in ("命令", "运行", "执行")) or lowered.startswith(("git ", "bun ", "npm ", "python ", "ssh ")):
        return "command"
    return "fact"


def build_note(title: str, text: str, now: datetime) -> str:
    note_type = infer_note_type(text)
    timestamp = now.strftime("%Y-%m-%d %H:%M")
    return f"""---
title: {yaml_quote(title)}
date: {yaml_quote(timestamp)}
source_type: quick_note
status: captured
tags: [quick-note, {note_type}]
---

# {title}

## 原始记录

{text}

## 初步归类

- 类型：{note_type}
- 相关页面：待定

## 编译建议

- 是否需要进入 wiki：later
- 建议目标：待定
"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Capture quick notes into ~/llm-wiki/raw/notes.")
    parser.add_argument("text", nargs="*", help="Quick note content. If omitted, stdin is used.")
    parser.add_argument("--title", help="Optional note title.")
    parser.add_argument("--no-sync", action="store_true", help="Do not run llm-wiki-refresh after capture.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    text = " ".join(args.text).strip() if args.text else sys.stdin.read().strip()
    if not text:
        print("error: note content is required", file=sys.stderr)
        return 2
    # 标题、文件名和正文必须源自同一份已脱敏文本；只在写正文时脱敏会把
    # prompt 第一行里的 token 泄漏进 YAML title、Markdown heading 和文件名。
    text = redact(text)

    now = datetime.now()
    title = redact(args.title.strip()) if args.title else text.splitlines()[0].strip()[:60]
    title = title or "Quick note"
    filename = f"{now.strftime('%Y-%m-%d-%H%M')}-{slugify(title, 'quick-note')}.md"
    NOTES_DIR.mkdir(parents=True, exist_ok=True)
    path = NOTES_DIR / filename
    if path.exists():
        filename = f"{now.strftime('%Y-%m-%d-%H%M%S')}-{slugify(title, 'quick-note')}.md"
        path = NOTES_DIR / filename
    path.write_text(build_note(title, text, now), encoding="utf-8")
    print(f"note={path}")

    if not args.no_sync:
        # _resolve_refresh() 可能回落成裸命令名，交给 PATH 解析；
        # 两条路都找不到时明确告知，不静默跳过刷新。
        if Path(REFRESH_COMMAND).exists() or shutil.which(REFRESH_COMMAND):
            subprocess.run([REFRESH_COMMAND], check=True)
        else:
            print(
                f"warn: 未找到 {REFRESH_COMMAND}，已跳过派生页刷新。"
                "笔记已写入，可稍后手动跑 llm-wiki-refresh。",
                file=sys.stderr,
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
