#!/usr/bin/env python3
"""LLM Wiki secret scanner.

用于 pre-commit 门禁与手动全量审计。
设计原则：
- 只报「高置信」，避免因误报导致用户习惯性 --no-verify（那等于没有门禁）
- 两类规则：
  A. 厂商前缀指纹（sk-ant-/ghp_/gsk_/xoxb- 等）—— 强信号
  B. 紧邻赋值 + 高熵 —— key: value 形式，排除占位符与摘要
- 白名单走 .secret-allowlist（fingerprint 行），不写明文
"""
from __future__ import annotations
import hashlib, math, re, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ALLOWLIST = ROOT / ".secret-allowlist"

VENDOR = [
    ("anthropic",  re.compile(r"sk-ant-[A-Za-z0-9_\-]{20,}")),
    ("openai-sk",  re.compile(r"\bsk-(?!ant-)[A-Za-z0-9_\-]{20,}")),
    ("github-pat", re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}")),
    ("groq",       re.compile(r"\bgsk_[A-Za-z0-9]{40,}")),
    ("slack",      re.compile(r"\bxox[baprs]-[A-Za-z0-9\-]{10,}")),
    ("google-api", re.compile(r"\bAIza[0-9A-Za-z_\-]{30,}")),
    ("aws-akid",   re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("jwt",        re.compile(r"\beyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}")),
    ("pem",        re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("xai",        re.compile(r"\bxai-[A-Za-z0-9]{20,}")),
    ("telegram",   re.compile(r"\b\d{8,10}:AA[A-Za-z0-9_\-]{32,}")),
]

# \b 在关键词两侧都会失效：
#   左侧：db_password / MYSQL_PASSWORD（关键词左邻是 "_"）
#   右侧：secret_key / token_value（关键词右邻是 "_"）
# 这两种带缀命名在真实代码里比裸关键词更常见，所以边界写成显式规则：
# 拒绝字母数字邻接（避免 tokenizer / notapassword 误报），放行 _/- 词缀。
ASSIGN = re.compile(
    r"(?i)(?<![A-Za-z0-9])(api[_\- ]?key|apikey|secret|token|password|passwd|credential|"
    r"private[_\- ]?key|access[_\- ]?key|auth[_\- ]?token|bearer|密码|密钥|私钥|口令)"
    r"(?:[_\-][A-Za-z0-9]+)*"
    r"(?![A-Za-z0-9])"
    r"\s*[:=]\s*[\"'`]?([^\s\"'`,;)}\]]{12,})"
)

PLACEHOLDER = re.compile(
    r"(?i)(REDACTED|见\s*secure-notes|secure-notes/|<[^>]*>|\{\{|\}\}|xxx+|\.\.\.|"
    r"placeholder|example|your[_\- ]|dummy|sample|FAKE|TODO|CHANGEME|\*{3,}|占位)"
)
HEX64 = re.compile(r"^[0-9a-f]{64}$")
HEX40 = re.compile(r"^[0-9a-f]{40}$")
# 代码引用而非字面值：$VAR / ${VAR} / $(cmd) / `cmd` / %s / {var} / os.environ[...]
CODEREF = re.compile(
    r"^(?:\$[A-Za-z_{(]|`|%\(|%s|\{[A-Za-z_]|os\.environ|process\.env|"
    r"System\.getenv|getenv\()"
)
# 代码表达式而非凭据：标识符紧跟 ( 或 [，如 re.compile( / list[tuple[ 。
# 用于拦住 `SECRET_PATTERNS: list[...]` / `TOKEN_RE = re.compile(...)` 这类
# 类型注解与常量定义。凭据字符集是 alnum 加 -_.~+/=，实际不含 ( 或 [，
# 所以这条不会放过真凭据。CODEREF 是行首锚定，抓不到中间的代码特征，故另设一条。
CODEEXPR = re.compile(r"[A-Za-z_][A-Za-z0-9_.]*[\[(]")

def entropy(s: str) -> float:
    if not s: return 0.0
    return -sum((c := s.count(ch) / len(s)) * math.log2(c) for ch in set(s))

def fp(kind: str, val: str) -> str:
    return f"{kind}:{hashlib.sha256(val.encode()).hexdigest()[:16]}"

def load_allow() -> set[str]:
    if not ALLOWLIST.exists(): return set()
    return {
        ln.split("#")[0].strip()
        for ln in ALLOWLIST.read_text().splitlines()
        if ln.strip() and not ln.strip().startswith("#")
    } - {""}

def scan_text(text: str, allow: set[str]):
    hits = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if len(line) > 20000:
            continue
        for kind, rx in VENDOR:
            for m in rx.finditer(line):
                val = m.group(0)
                if PLACEHOLDER.search(val):
                    continue
                f = fp(kind, val)
                if f in allow:
                    continue
                hits.append((lineno, kind, len(val), f))
        for m in ASSIGN.finditer(line):
            key, val = m.group(1), m.group(2)
            if PLACEHOLDER.search(val) or CODEREF.match(val):
                continue
            if CODEEXPR.search(val):
                continue          # 类型注解 / 函数调用等代码表达式，非凭据
            if HEX64.match(val) or HEX40.match(val):
                continue          # SHA-256 / git SHA 摘要，非凭据
            if entropy(val) < 3.2 or len(set(val)) < 8:
                continue
            f = fp("assign", val)
            if f in allow:
                continue
            hits.append((lineno, f"assign:{key.lower()}", len(val), f))
    return hits

def _read_index_blob(rel: str) -> str | None:
    """读取 git 索引（staged）中的内容，而不是工作树。

    关键：若凭据版本已 `git add`，随后在工作树脱敏但未重新 add，
    读工作树会漏检索引里的凭据。门禁必须以「即将提交的字节」为准。
    """
    r = subprocess.run(["git", "show", f":{rel}"],
                       cwd=ROOT, capture_output=True, check=False)
    if r.returncode != 0:
        return None
    return r.stdout.decode("utf-8", errors="replace")


def iter_targets(argv):
    """yield (显示名, 文本内容)。内容来源随模式不同。"""
    if argv and argv[0] == "--staged":
        out = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACM"],
            cwd=ROOT, capture_output=True, text=True, check=True).stdout
        for rel in filter(None, out.split("\0")):
            text = _read_index_blob(rel)
            if text is not None:
                yield rel, text
    elif argv and argv[0] == "--all":
        skip = {".git", "graphify-out", "node_modules", "__pycache__"}
        for p in sorted(ROOT.rglob("*")):
            if p.is_file() and not any(s in p.parts for s in skip):
                try:
                    yield str(p.relative_to(ROOT)), p.read_text(errors="replace")
                except Exception:
                    continue
    else:
        for a in argv:
            p = Path(a)
            if p.is_file():
                try:
                    yield str(p), p.read_text(errors="replace")
                except Exception:
                    continue

def main() -> int:
    argv = sys.argv[1:] or ["--all"]
    allow = load_allow()
    total = 0
    for rel, text in iter_targets(argv):
        for lineno, kind, ln, f in scan_text(text, allow):
            print(f"  [{kind}] {rel}:{lineno} len={ln} fingerprint={f}")
            total += 1
    if total:
        print(f"\n✗ 发现 {total} 处高置信凭据。处理方式：")
        print("  1) 真凭据 → 移到 ~/secure-notes/，正文改写 `<见 secure-notes/xxx>`")
        print("  2) 确认无害 → 把 fingerprint 追加到 .secret-allowlist（不写明文）")
        return 1
    print(f"✓ secret scan clean (allowlist {len(allow)} 条)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
