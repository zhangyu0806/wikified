#!/usr/bin/env python3
"""Refresh derived Wikified pages, then sync the Obsidian mirror.

Generated surfaces:
- Today.md
- wiki/dashboards/projects.md
- wiki/dashboards/health.md
- wiki/dashboards/review.md

This command is intended to run after every human-approved wiki ingest so the
Obsidian mirror is always current without a separate manual sync step.
"""

from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


DEFAULT_ROOT = Path.home() / "llm-wiki"
SENSITIVE_TERMS = {
    "authorization": re.compile(r"\bAuthorization\b", re.IGNORECASE),
    "bearer": re.compile(r"\bBearer\b", re.IGNORECASE),
    "api-key": re.compile(r"\bapi[_-]?key\b", re.IGNORECASE),
    "token": re.compile(r"\btoken\b", re.IGNORECASE),
    "password": re.compile(r"\bpassword\b", re.IGNORECASE),
    "secret": re.compile(r"\bsecret\b", re.IGNORECASE),
}
NON_COMPILABLE_QUALITY_GATES = {"partial_excerpt_only", "failed_no_transcript_or_full_article"}
NON_COMPILABLE_STATUSES = {"needs_full_text", "deferred"}
NEXT_ACTION_RE = re.compile(r"(后续|下一步|待办|TODO|Next)", re.IGNORECASE)


def resolve_sibling_command(name: str) -> str:
    """Resolve a sibling command without depending on the caller's PATH."""
    candidates = [Path(__file__).resolve().parent]
    env_bin = os.environ.get("LLM_WIKI_BIN_TARGET")
    if env_bin:
        candidates.append(Path(env_bin).expanduser())
    candidates.append(Path.home() / ".local" / "bin")
    for directory in candidates:
        candidate = directory / name
        if candidate.exists():
            return str(candidate)
    return name


OBSIDIAN_SYNC_COMMAND = resolve_sibling_command("llm-wiki-obsidian-sync")
REVIEW_COMMAND = resolve_sibling_command("llm-wiki-review")


@dataclass(frozen=True)
class Page:
    path: Path
    rel: Path
    title: str
    updated: str
    status: str
    quality_gate: str
    sources: list[str]
    body: str


def fail(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def split_frontmatter(text: str) -> tuple[dict[str, str], str]:
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end == -1:
        return {}, text
    raw = text[4:end].strip()
    body = text[end + 5 :]
    data: dict[str, str] = {}
    for line in raw.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip()
    return data, body


def parse_list(value: str) -> list[str]:
    value = value.strip()
    if not value.startswith("[") or not value.endswith("]"):
        return []
    inner = value[1:-1].strip()
    if not inner:
        return []
    return [item.strip().strip('"\'') for item in inner.split(",") if item.strip()]


def parse_page(root: Path, path: Path) -> Page:
    text = read_text(path)
    fm, body = split_frontmatter(text)
    title = fm.get("title") or first_heading(body) or path.stem
    updated = fm.get("updated") or fm.get("date") or fm.get("created") or ""
    status = fm.get("status", "")
    quality_gate = fm.get("quality_gate", "")
    sources = parse_list(fm.get("sources", ""))
    return Page(
        path=path,
        rel=path.relative_to(root),
        title=title,
        updated=updated,
        status=status,
        quality_gate=quality_gate,
        sources=sources,
        body=body,
    )


def first_heading(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def markdown_files(path: Path) -> list[Path]:
    if not path.exists():
        return []
    return sorted(
        item
        for item in path.rglob("*.md")
        if item.is_file() and "graphify-out" not in item.relative_to(path).parts
    )


def git_ignored(root: Path, paths: list[Path]) -> set[Path]:
    """Return the subset of paths ignored by git.

    The ignore rules are the contract for machine-local drafts such as
    raw/inbox/auto-drafts/. If this probe is unavailable, fall back to reporting
    more rather than silently hiding a real review item.
    """
    if not paths or not (root / ".git").exists():
        return set()
    rels: list[str] = []
    for path in paths:
        try:
            rels.append(path.relative_to(root).as_posix())
        except ValueError:
            rels.append(path.as_posix())
    try:
        proc = subprocess.run(
            ["git", "-C", str(root), "check-ignore", "--stdin"],
            input="\n".join(rels),
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return set()
    if proc.returncode not in (0, 1):
        return set()
    return {root / line.strip() for line in proc.stdout.splitlines() if line.strip()}


def reviewable_raw_files(root: Path) -> list[Path]:
    raw_files = markdown_files(root / "raw")
    ignored = git_ignored(root, raw_files)
    return [path for path in raw_files if path not in ignored]


def date_from_name(path: Path) -> str:
    match = re.match(r"(\d{4}-\d{2}-\d{2})", path.name)
    return match.group(1) if match else ""


def is_today(path: Path, today: dt.date) -> bool:
    prefix = date_from_name(path)
    if prefix == today.isoformat():
        return True
    modified = dt.datetime.fromtimestamp(path.stat().st_mtime).date()
    return modified == today


def wiki_link(page: Page) -> str:
    return f"[[{page.rel.with_suffix('').as_posix()}|{page.title}]]"


def raw_link(root: Path, path: Path) -> str:
    rel = path.relative_to(root).with_suffix("").as_posix()
    return f"[[{rel}|{path.stem}]]"


def extract_section_lines(body: str, section_patterns: tuple[str, ...], limit: int = 8) -> list[str]:
    lines = body.splitlines()
    collected: list[str] = []
    in_section = False
    for line in lines:
        if line.startswith("##"):
            in_section = any(pattern in line for pattern in section_patterns)
            continue
        if in_section and line.strip().startswith(("- ", "- [", "* ")):
            collected.append(line.strip())
            if len(collected) >= limit:
                break
    return collected


def has_next_action(page: Page) -> bool:
    if NEXT_ACTION_RE.search(page.body):
        return True
    return any(marker in page.body for marker in ("- [ ]", "TODO", "todo"))


def can_compile_raw(page: Page) -> bool:
    if page.quality_gate in NON_COMPILABLE_QUALITY_GATES:
        return False
    if page.status in NON_COMPILABLE_STATUSES:
        return False
    return True


def needs_full_text(page: Page) -> bool:
    if page.status in NON_COMPILABLE_STATUSES:
        return True
    if page.status == "compiled":
        return False
    return page.quality_gate in NON_COMPILABLE_QUALITY_GATES


def write_today(root: Path, pages: list[Page], raw_files: list[Path], now: dt.datetime) -> None:
    today = now.date()
    today_raw = [path for path in raw_files if is_today(path, today)]
    today_pages = [page for page in pages if page.updated == today.isoformat() or is_today(page.path, today)]
    today_decisions = [page for page in today_pages if "decisions" in page.rel.parts]

    pitfall_items: list[str] = []
    for path in today_raw:
        text = read_text(path)
        for line in text.splitlines():
            if any(marker in line for marker in ("踩坑", "坑", "bug", "错误", "失败", "修复")):
                pitfall_items.append(f"- {raw_link(root, path)}：{line.strip().lstrip('- ').strip()}")
                break

    todo_items: list[str] = []
    for page in today_pages:
        for line in extract_section_lines(page.body, ("后续", "下一步", "待办", "TODO"), limit=3):
            todo_items.append(f"- {wiki_link(page)}：{line.lstrip('- ').strip()}")

    content = f"""# Today

> 今日沉淀入口页。由 `llm-wiki-refresh` 自动生成。  
> 生成时间：{now.strftime('%Y-%m-%d %H:%M:%S %Z')}

## 今日新增记录

{bullet_list(raw_link(root, path) for path in today_raw) or '- 暂无'}

## 今日更新页面

{bullet_list(wiki_link(page) for page in today_pages) or '- 暂无'}

## 今日踩坑

{chr(10).join(pitfall_items) if pitfall_items else '- 暂无'}

## 今日决策

{bullet_list(wiki_link(page) for page in today_decisions) or '- 暂无'}

## 待复盘事项

{chr(10).join(todo_items) if todo_items else '- 暂无'}
"""
    (root / "Today.md").write_text(content, encoding="utf-8")


def bullet_list(items: object) -> str:
    values = list(items)
    return "\n".join(f"- {item}" for item in values)


def write_projects_dashboard(root: Path, project_pages: list[Page], now: dt.datetime) -> None:
    dashboard = root / "wiki" / "dashboards" / "projects.md"
    dashboard.parent.mkdir(parents=True, exist_ok=True)
    today = now.date().isoformat()

    groups = {"active": [], "paused": [], "completed": [], "unknown": []}
    for page in project_pages:
        groups.get(page.status, groups["unknown"]).append(page)

    sections = []
    for status, title in (("active", "Active"), ("paused", "Paused"), ("completed", "Completed"), ("unknown", "Unknown")):
        rows = []
        for page in sorted(groups[status], key=lambda item: item.title.lower()):
            next_actions = extract_section_lines(page.body, ("后续", "下一步", "待办", "TODO"), limit=2)
            next_text = "<br>".join(line.lstrip("- ").strip() for line in next_actions) if next_actions else "—"
            rows.append(f"| {wiki_link(page)} | {page.updated or '—'} | {next_text} |")
        table = "\n".join(rows) if rows else "| — | — | — |"
        sections.append(f"## {title}\n\n| 项目 | 更新 | 下一步 |\n|---|---|---|\n{table}")

    body = f"""# 项目仪表盘

按 `active / paused / completed` 汇总 `wiki/projects/` 页面。由 `llm-wiki-refresh` 自动生成。

{chr(10).join(sections)}
"""

    created = today
    if dashboard.exists():
        existing_text = read_text(dashboard)
        existing_meta, existing_body = split_frontmatter(existing_text)
        created = existing_meta.get("created", today)
        if existing_body.strip() == body.strip():
            return

    content = f"""---
title: 项目仪表盘
created: {created}
updated: {today}
tags: [dashboard, projects, llm-wiki]
---

{body}
"""
    dashboard.write_text(content, encoding="utf-8")


def strip_code(text: str) -> str:
    """Remove fenced code blocks and inline code so wiki-link extraction
    doesn't pick up `[[` sequences inside code examples
    (e.g. SGR escape sequences like ``^[[<0;96;99m``)."""
    text = re.sub(r"```.*?```", "", text, flags=re.DOTALL)
    out_lines: list[str] = []
    for line in text.splitlines():
        if line.startswith("    ") or line.startswith("\t"):
            continue
        out_lines.append(line)
    text = "\n".join(out_lines)
    text = re.sub(r"`[^`]*`", "", text)
    return text


def link_targets(text: str) -> list[str]:
    return re.findall(r"\[\[([^\]]+)\]\]", strip_code(text))


def target_exists(root: Path, target: str, slugs: set[str]) -> bool:
    target = target.split("|", 1)[0].split("#", 1)[0].strip()
    if not target:
        return True
    if target in slugs or Path(target).stem in slugs:
        return True
    candidate = root / f"{target}.md"
    return candidate.exists()


def referenced_raws(root: Path, pages: list[Page]) -> set[str]:
    refs: set[str] = set()
    log_text = read_text(root / "wiki" / "log.md") if (root / "wiki" / "log.md").exists() else ""
    combined = log_text + "\n" + "\n".join("\n".join(page.sources) for page in pages)
    for match in re.findall(r"raw/(?:sessions|notes|articles)/[^`\]\s,]+\.md", combined):
        refs.add(match)
    return refs


def write_health(root: Path, pages: list[Page], raw_files: list[Path], now: dt.datetime) -> None:
    dashboard = root / "wiki" / "dashboards" / "health.md"
    dashboard.parent.mkdir(parents=True, exist_ok=True)
    today = now.date()

    stale: list[str] = []
    for page in pages:
        if not page.updated:
            continue
        try:
            updated_date = dt.date.fromisoformat(page.updated[:10])
        except ValueError:
            continue
        if (today - updated_date).days > 30:
            stale.append(f"- {wiki_link(page)}：{(today - updated_date).days} 天未更新")

    active_without_next = [f"- {wiki_link(page)}" for page in pages if page.rel.parts[:1] == ("wiki",) and "projects" in page.rel.parts and page.status == "active" and not has_next_action(page)]

    refs = referenced_raws(root, pages)
    raw_pages = [parse_page(root, path) for path in raw_files]
    raw_needing_full_text = [
        f"- `{page.rel.as_posix()}`：status=`{page.status or '—'}`，quality_gate=`{page.quality_gate or '—'}`"
        for page in raw_pages
        if needs_full_text(page)
    ]

    uncompiled = []
    for page in raw_pages:
        rel = page.rel.as_posix()
        if not can_compile_raw(page):
            continue
        if rel not in refs:
            uncompiled.append(f"- `{rel}`")

    slugs = {page.path.stem for page in pages} | {"SCHEMA", "Today", "LLM Wiki Mirror", "projects", "health", "review"}
    broken = []
    for page in pages:
        if page.rel.as_posix() == "wiki/dashboards/health.md":
            continue
        for target in link_targets(page.body):
            if not target_exists(root, target, slugs):
                broken.append(f"- {wiki_link(page)} → `[[{target}]]`")

    sensitive = []
    tools_dir = root / "wiki" / "tools"
    for path in markdown_files(tools_dir):
        text = read_text(path)
        found = sorted(name for name, pattern in SENSITIVE_TERMS.items() if pattern.search(text))
        if found:
            rel = path.relative_to(root).as_posix()
            sensitive.append(f"- `{rel}`：疑似关键词 {', '.join(found)}（仅提示，不展开内容）")

    content = f"""---
title: Wikified 健康检查
created: {today.isoformat()}
updated: {today.isoformat()}
tags: [dashboard, health, llm-wiki]
---

# Wikified 健康检查

由 `llm-wiki-refresh` 自动生成。生成时间：{now.strftime('%Y-%m-%d %H:%M:%S %Z')}

## 超过 30 天未更新页面

{chr(10).join(stale) if stale else '- 暂无'}

## Active 项目缺少下一步

{chr(10).join(active_without_next) if active_without_next else '- 暂无'}

## 可能未编译 raw

{chr(10).join(uncompiled) if uncompiled else '- 暂无'}

## 待完整抓取 raw

{chr(10).join(raw_needing_full_text) if raw_needing_full_text else '- 暂无'}

## Obsidian/Wiki 断链

{chr(10).join(broken) if broken else '- 暂无'}

## 工具页敏感信息关键词提示

{chr(10).join(sensitive) if sensitive else '- 暂无'}
"""
    dashboard.write_text(content, encoding="utf-8")


def write_review_dashboard(root: Path, now: dt.datetime) -> None:
    dashboard = root / "wiki" / "dashboards" / "review.md"
    dashboard.parent.mkdir(parents=True, exist_ok=True)
    result = subprocess.run(
        [REVIEW_COMMAND, "--root", str(root), "--peek"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(result.stderr or result.stdout or "", end="", file=sys.stderr)
        raise SystemExit(result.returncode)

    today = now.date()
    content = f"""---
title: Wikified 复盘清单
created: {today.isoformat()}
updated: {today.isoformat()}
tags: [dashboard, review, llm-wiki]
---

{result.stdout.rstrip()}
"""
    dashboard.write_text(content, encoding="utf-8")


def run_sync(root: Path) -> None:
    """把库镜像到 Obsidian vault。镜像未配置时跳过，不视为失败。

    镜像是可选的展示层，核心写入路径不能因它缺失而失败：llm-wiki-note 会调
    本命令，若在此抛错，未配置镜像的用户连记笔记都做不了。
    """
    result = subprocess.run(
        [OBSIDIAN_SYNC_COMMAND, "--source", str(root)],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        if result.stdout:
            print(result.stdout, end="")
        return
    # obsidian-sync 用 rc=1 表示「没有镜像目标」，这是未配置而非故障。
    if "no mirror target" in (result.stderr or ""):
        print("skipped Obsidian mirror: LLM_WIKI_MIRROR not set (see llm-wiki-obsidian-sync --help)")
        return
    print(result.stderr or "", end="", file=sys.stderr)
    raise SystemExit(result.returncode)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Refresh derived Wikified pages and sync Obsidian mirror.")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT, help="Wikified data root directory")
    parser.add_argument("--no-sync", action="store_true", help="Generate derived pages without running llm-wiki-obsidian-sync")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    root = args.root.expanduser().resolve()
    if not (root / "SCHEMA.md").exists():
        fail(f"not a Wikified data root, missing SCHEMA.md: {root}")

    now = dt.datetime.now().astimezone()
    pages = [parse_page(root, path) for path in markdown_files(root / "wiki")]
    project_pages = [page for page in pages if page.rel.parts[:2] == ("wiki", "projects")]
    raw_files = reviewable_raw_files(root)

    write_today(root, pages, raw_files, now)
    pages = [parse_page(root, path) for path in markdown_files(root / "wiki")]
    project_pages = [page for page in pages if page.rel.parts[:2] == ("wiki", "projects")]
    write_projects_dashboard(root, project_pages, now)
    pages = [parse_page(root, path) for path in markdown_files(root / "wiki")]
    write_health(root, pages, raw_files, now)
    write_review_dashboard(root, now)

    if not args.no_sync:
        run_sync(root)

    print(f"root={root}")
    print(f"today={root / 'Today.md'}")
    print(f"projects_dashboard={root / 'wiki' / 'dashboards' / 'projects.md'}")
    print(f"health_dashboard={root / 'wiki' / 'dashboards' / 'health.md'}")
    print(f"review_dashboard={root / 'wiki' / 'dashboards' / 'review.md'}")
    print(f"synced={not args.no_sync}")


if __name__ == "__main__":
    main()
